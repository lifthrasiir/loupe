{
  "manifest_version": 3,
  "name": "Loupe",
  "version": "0.1.0",
  "icons": {
    "16": "loupe_icon_16.png",
    "32": "loupe_icon_32.png",
    "48": "loupe_icon_48.png",
    "128": "loupe_icon_128.png"
  },
  "description": "OCR overlay for images and canvases",
  "permissions": [
    "activeTab",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "run-ocr": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "Run OCR on image/canvas under cursor"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "overlay.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "model_manifest.json",
        "det_weights_f16.bin",
        "rec_weights_f16.bin"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}